{
  "name": "react-native-board-view",
  "version": "1.2.0",
  "description": "Kanban and swimlane boards for React Native and Expo. Virtualized columns, long-press drag, a Move to… sheet, and optimistic moves with rollback. Your items stay the source of truth.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishaal2002/react-native-board-view.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/vishaal2002/react-native-board-view#readme",
  "bugs": {
    "url": "https://github.com/vishaal2002/react-native-board-view/issues"
  },
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./testing": {
      "source": "./src/testing.ts",
      "import": {
        "types": "./lib/typescript/module/testing.d.ts",
        "default": "./lib/module/testing.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/testing.d.ts",
        "default": "./lib/commonjs/testing.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "sed '/<!-- github-only -->/,/<!-- \\/github-only -->/d' ../../README.md > README.md && bob build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "board-view-core": "1.0.0"
  },
  "peerDependencies": {
    "@shopify/flash-list": ">=2.0.2 <3",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "react-native-gesture-handler": ">=2.28.0 <4",
    "react-native-reanimated": ">=4.1.0 <5",
    "react-native-worklets": ">=0.5.0 <1"
  },
  "keywords": [
    "react-native",
    "expo",
    "kanban",
    "board",
    "swimlanes",
    "drag-and-drop",
    "flash-list",
    "reanimated",
    "accessibility"
  ],
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/*.test.{ts,tsx}"
  }
}
