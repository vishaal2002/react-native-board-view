{
  "name": "react-native-board-view",
  "version": "0.0.0",
  "description": "Board view for React Native and Expo. The board is a projection of your items, not the source of truth.",
  "license": "MIT",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-native-board-view-core": "0.0.0",
    "react-native-drax": "1.1.0"
  },
  "peerDependencies": {
    "@shopify/flash-list": ">=2.0.0",
    "react": ">=19.0.0",
    "react-native": ">=0.83.0",
    "react-native-gesture-handler": ">=2.28.0 <3",
    "react-native-reanimated": ">=4.1.0 <5",
    "react-native-worklets": ">=0.7.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "kanban",
    "board",
    "drag-and-drop"
  ]
}
