{
  "name": "board-view-core",
  "version": "0.2.0",
  "description": "Board model for flat data: grouping into columns and swimlanes, fractional ranks, move planning and an optimistic move queue. No React or React Native dependency.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vishaal2002/react-native-board-view.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/vishaal2002/react-native-board-view/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/vishaal2002/react-native-board-view/issues"
  },
  "sideEffects": false,
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bob build",
    "prepack": "bob build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.."
  },
  "dependencies": {
    "fractional-indexing": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  },
  "keywords": [
    "kanban",
    "board",
    "fractional-indexing",
    "optimistic-updates",
    "swimlanes"
  ],
  "publishConfig": {
    "access": "public"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": "**/*.test.{ts,tsx}"
  }
}
