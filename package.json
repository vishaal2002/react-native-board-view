{
  "name": "react-native-board-view-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages",
    "check:hosts": "node scripts/check-hosts.mjs",
    "example": "npm run start -w board-view-example -- --port 43123",
    "example:web": "npm run web -w board-view-example",
    "bare": "npm run start -w board-view-bare -- --port 43124",
    "build": "npm run build -w board-view-core && npm run build -w react-native-board-view",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "jsdom": "27.4.0",
    "prettier": "3.6.2",
    "react-dom": "19.2.3",
    "react-native-builder-bob": "0.43.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.11.0"
  }
}
